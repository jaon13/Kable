<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 전천후 멀티 타겟팅: 구형 설비(netstandard2.0)부터 최신 고성능(.NET 8, 10)까지 완전 지원 -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- NuGet 패키지 메타데이터 (글로벌 오픈소스 규격) -->
    <PackageId>Kable</PackageId>
    <Version>1.0.0</Version>
    <Authors>Johnny</Authors>
    <Company>Smart LIMS</Company>
    <Description>High-performance, Zero-Allocation reactive hardware communication engine combining Bedrock Pipelines and RSocket interaction patterns.</Description>
    <PackageTags>industrial;hardware;serial;socket;namedpipe;pipelines;rsocket;reactive;zerogc</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jaon13/Kable</RepositoryUrl>
  </PropertyGroup>

  <!-- 공통 종속성 (최신 System.Threading.Channels 포함) -->
  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kable.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- netstandard2.0 구형 플랫폼용 폴리필 패키지 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

</Project>
